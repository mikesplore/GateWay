# PostgreSQL connection used by the GateWay service.
DB_URL=jdbc:postgresql://localhost:5432/gateway
DB_USER=gateway
DB_PASSWORD=change-me

# Paystack secret key. Use a test key for local development.
PAYSTACK_SECRET_KEY=sk_test_replace_me

# M-Pesa Daraja STK Push. Set all credentials and a random callback token before enabling M-Pesa.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Optional for sandbox (defaults to Safaricom's shared Express test values); required for production.
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_TOKEN=

# Set disabled in production until account provisioning/verification is implemented.
ACCOUNT_CREATION_MODE=open
GATEWAY_OPS_TOKEN=
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_SECONDS=300
RECONCILIATION_STALE_MINUTES=10
RECONCILIATION_BATCH_SIZE=100

# HTTP listener port and public base URL used for the Paystack browser callback.
PORT=8080
GATEWAY_PUBLIC_URL=http://localhost:8080

# Optional host Nginx enforcement. Leave disabled for payment-only deployments.
NGINX_ENABLED=false
NGINX_MANAGED_DIRECTORY=/etc/nginx/gateway.d
NGINX_CONFLICT_DIRECTORIES=/etc/nginx/sites-enabled,/etc/nginx/conf.d
NGINX_INSPECTION_DIRECTORIES=/etc/nginx/sites-available,/etc/nginx/sites-enabled,/etc/nginx/conf.d
NGINX_EXECUTABLE=/usr/sbin/nginx
NGINX_CERTIFICATE_DIRECTORY=/etc/letsencrypt/live
# Optional executable helper contract: gateway-cert-helper ensure <domain> <email>
GATEWAY_CERTIFICATE_HELPER=
GATEWAY_CERTIFICATE_EMAIL=
